# ---- Fridgey environment ----
# Everything is optional. With no variables set the app runs in demo mode.

# Clerk (live authentication). Both are required to enable sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# TigerData / PostgreSQL connection string for live mode persistence.
# e.g. postgres://user:password@host:5432/fridgey?sslmode=require
DATABASE_URL=

# Gemini food recognition (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs voice assistant preview (server-side only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Solana Devnet reward payouts. The payer secret key never reaches the browser.
# Accepts a base58 string or a JSON byte array from `solana-keygen`.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_SECRET_KEY=

# Shared bearer token the fridge hardware uses to POST readings to /api/sensors/ingest.
FRIDGE_INGEST_TOKEN=

# Optional: a MapLibre style URL. Defaults to OpenFreeMap Positron (no key needed).
NEXT_PUBLIC_MAP_STYLE_URL=
