GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
FRIDGE_CAMERA_INDEX=0
FRIDGE_INVENTORY_CAMERA=1
FRIDGE_AUDIT_INTERVAL=300
FRIDGE_DATA_API_URL=http://127.0.0.1:3200
FRIDGE_ECHO_GUARD=mute
# Optional audio device names. Blank uses the Mac's default devices.
FRIDGE_MIC_DEVICE=
FRIDGE_SPEAKER_DEVICE=

# Correct a horizontally reversed source; keep 0 for an already-correct camera.
FRIDGE_FRONT_MIRROR=0
FRIDGE_SHELF_MIRROR=0

# Optional macOS physical camera names (indices can change when iPhone connects).
FRIDGE_FRONT_CAMERA_NAME=
FRIDGE_SHELF_CAMERA_NAME=
